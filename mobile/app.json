{
  "expo": {
    "name": "Khan",
    "slug": "khan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "com.khan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.khan.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
